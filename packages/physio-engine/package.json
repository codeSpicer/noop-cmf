{
  "name": "@noop-cmf/physio-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript physiological math: Karvonen zones, Banister TRIMP, logarithmic strain, sleep architecture, eHRV, rolling recovery, and habit correlation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noop-cmf/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
